{
    "schemaVersion": 1,
    "id": "rtx-remix-renderer",
    "version": "${version}",
    "name": "RTX Remix for Minecraft 26.2 (Unofficial)",
    "description": "Renders Minecraft through NVIDIA RTX Remix path tracing. NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT.",
    "authors": [
        "NVIDIA (original mod and renderer)",
        "yeezybeezydeezy (community 26.3 port)",
        "Phil24k (26.2 fork)"
    ],
    "contact": {
        "homepage": "https://github.com/phil24k/rtx-remix-minecraft-26.2",
        "sources": "https://github.com/phil24k/rtx-remix-minecraft-26.2",
        "issues": "https://github.com/phil24k/rtx-remix-minecraft-26.2/issues"
    },
    "license": "Apache-2.0",
    "environment": "*",
    "entrypoints": {
        "preLaunch": [
            "com.nvidia.rtxremix.minecraft.WorkerPoolCap"
        ],
        "main": [
            "com.nvidia.rtxremix.minecraft.RtxRemixCommonMod"
        ],
        "client": [
            "com.nvidia.rtxremix.minecraft.RtxRemixMod"
        ]
    },
    "mixins": [
        "rtx-remix-renderer.mixins.json"
    ],
    "accessWidener": "rtx-remix-renderer.accesswidener",
    "depends": {
        "fabricloader": ">=0.20.1",
        "fabric-api": ">=0.161.0+26.2",
        "minecraft": "26.2",
        "java": ">=25"
    }
}
